<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Production MS-Wise Tracking (Trial)</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

    body {
      background: #0b1120;
      color: #e2e8f0;
      font-family: 'Poppins', sans-serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Top Bar */
    .top-bar {
      position: sticky;
      top: 0;
      background: #1e293b;
      border-bottom: 2px solid #f97316;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 20px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.8);
      z-index: 1000;
    }
    .top-bar h1 { font-size: 15px; margin: 0; color: #f8fafc; font-weight: 700; }
    .back-btn {
      background: #0f172a;
      border: 1px solid #334155;
      color: #38bdf8;
      padding: 6px 14px;
      border-radius: 6px;
      font-weight: 600;
      text-decoration: none;
      font-size: 12px;
    }

    .main-wrap {
      max-width: 1500px;
      width: 100%;
      margin: 0 auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* KPI Cards */
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }
    .kpi-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 10px;
      padding: 14px;
      position: relative;
      overflow: hidden;
    }
    .kpi-card::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      height: 3px;
      width: 100%;
      background: #f97316;
    }
    .kpi-card.cyan::after { background: #38bdf8; }
    .kpi-card.green::after { background: #34d399; }
    .kpi-card.yellow::after { background: #fde047; }

    .kpi-card span { font-size: 11px; color: #94a3b8; font-weight: 600; text-transform: uppercase; }
    .kpi-card h2 { margin: 4px 0 0 0; font-size: 22px; color: #f8fafc; font-weight: 700; }

    /* Controls & Filter Ribbon */
    .control-box {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 10px;
      padding: 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: flex-end;
      justify-content: space-between;
    }
    .filter-group { display: flex; flex-direction: column; gap: 4px; }
    .filter-group label { font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; }
    .filter-group input, .filter-group select {
      background: #0f172a;
      border: 1px solid #334155;
      color: #f8fafc;
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 12px;
      outline: none;
      font-family: inherit;
    }
    .filter-group input:focus, .filter-group select:focus { border-color: #38bdf8; }

    .btn-add {
      background: #f97316;
      color: white;
      border: none;
      padding: 9px 16px;
      border-radius: 6px;
      font-weight: 700;
      cursor: pointer;
      font-size: 12px;
      transition: 0.2s;
    }
    .btn-add:hover { background: #ea580c; }

    /* Data Table Section */
    .table-container {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 10px;
      padding: 14px;
      overflow-x: auto;
    }
    table.ms-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
      text-align: center;
      white-space: nowrap;
    }
    table.ms-table th, table.ms-table td {
      border: 1px solid #334155;
      padding: 10px 8px;
    }
    table.ms-table th {
      background: #0f172a;
      color: #38bdf8;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 11px;
    }
    table.ms-table td { background: #172033; color: #f1f5f9; }
    table.ms-table tr:hover td { background: #1e293b; }

    .ms-tag {
      background: rgba(249, 115, 22, 0.2);
      color: #f97316;
      border: 1px solid #f97316;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 700;
      display: inline-block;
    }
    .sqf-tag {
      background: rgba(56, 189, 248, 0.2);
      color: #38bdf8;
      border: 1px solid #38bdf8;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: 600;
      display: inline-block;
    }

    /* Modal Form Overlay */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(7, 13, 27, 0.85);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      padding: 14px;
    }
    .modal-box {
      background: #1e293b;
      border: 2px solid #38bdf8;
      border-radius: 12px;
      width: 100%;
      max-width: 440px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #38bdf8;
      font-weight: 700;
      border-bottom: 1px solid #334155;
      padding-bottom: 8px;
    }
    .close-btn { font-size: 22px; cursor: pointer; color: #94a3b8; }
    .form-item { display: flex; flex-direction: column; gap: 4px; }
    .form-item label { font-size: 11px; color: #94a3b8; font-weight: 600; text-transform: uppercase; }
    .form-item input, .form-item select {
      background: #0f172a;
      border: 1px solid #334155;
      color: #fff;
      padding: 8px 10px;
      border-radius: 6px;
      font-size: 12px;
      outline: none;
    }
    .btn-submit {
      background: #34d399;
      color: #064e3b;
      border: none;
      padding: 10px;
      border-radius: 6px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 6px;
    }
  </style>
</head>
<body>

  <header class="top-bar">
    <h1>⚙️ Production Log - MS Number & SQF Wise (Trial Page)</h1>
    <a href="production.html" class="back-btn">⬅ Back to Main</a>
  </header>

  <div class="main-wrap">

    <!-- KPI Summary Row -->
    <div class="kpi-row">
      <div class="kpi-card">
        <span>Filtered Total Lots</span>
        <h2 id="kpiLots">0</h2>
      </div>
      <div class="kpi-card cyan">
        <span>Total Quantity (Pcs)</span>
        <h2 id="kpiQty">0 Pcs</h2>
      </div>
      <div class="kpi-card green">
        <span>Total Weight (Tons)</span>
        <h2 id="kpiTon">0.00 Ton</h2>
      </div>
      <div class="kpi-card yellow">
        <span>Active Furnaces</span>
        <h2 id="kpiSqfCount">4 SQFs</h2>
      </div>
    </div>

    <!-- Filters & Search Ribbon -->
    <div class="control-box">
      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <div class="filter-group">
          <label>Search MS / Part No</label>
          <input type="text" id="filterSearch" placeholder="e.g. MS-101 or Gear..." oninput="renderTable()">
        </div>
        <div class="filter-group">
          <label>Filter SQF No</label>
          <select id="filterSQF" onchange="renderTable()">
            <option value="ALL">All Furnaces</option>
            <option value="SQF-1">SQF-1</option>
            <option value="SQF-2">SQF-2</option>
            <option value="SQF-3">SQF-3</option>
            <option value="SQF-4">SQF-4</option>
          </select>
        </div>
        <div class="filter-group">
          <label>Filter Date</label>
          <input type="date" id="filterDate" onchange="renderTable()">
        </div>
      </div>

      <div style="display: flex; gap: 8px;">
        <button onclick="resetFilters()" style="background:transparent; border:1px solid #475569; color:#94a3b8; padding:8px 14px; border-radius:6px; cursor:pointer; font-size:12px;">Reset</button>
        <button class="btn-add" onclick="openModal()">+ Add New Entry</button>
      </div>
    </div>

    <!-- Main Table -->
    <div class="table-container">
      <table class="ms-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>MS Number</th>
            <th>SQF No</th>
            <th>Part No / Description</th>
            <th>Batch No</th>
            <th>Quantity (Pcs)</th>
            <th>Weight (Kg)</th>
            <th>Weight (Ton)</th>
            <th>Heat Code</th>
            <th>Remarks</th>
          </tr>
        </thead>
        <tbody id="tableBody">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>

  </div>

  <!-- Add Entry Modal -->
  <div class="modal-overlay" id="entryModal">
    <div class="modal-box">
      <div class="modal-header">
        <span>➕ Add MS Production Record</span>
        <span class="close-btn" onclick="closeModal()">&times;</span>
      </div>
      <form onsubmit="saveEntry(event)" style="display: flex; flex-direction: column; gap: 10px;">
        <div class="form-item">
          <label>Date</label>
          <input type="date" id="mDate" required>
        </div>
        <div class="form-item">
          <label>MS Number</label>
          <input type="text" id="mMsNo" placeholder="e.g. MS-101" required>
        </div>
        <div class="form-item">
          <label>SQF Number</label>
          <select id="mSqf" required>
            <option value="SQF-1">SQF-1</option>
            <option value="SQF-2">SQF-2</option>
            <option value="SQF-3">SQF-3</option>
            <option value="SQF-4">SQF-4</option>
          </select>
        </div>
        <div class="form-item">
          <label>Part No / Name</label>
          <input type="text" id="mPart" placeholder="e.g. 45/14 Pinion Shaft" required>
        </div>
        <div class="form-item">
          <label>Batch No</label>
          <input type="text" id="mBatch" placeholder="e.g. B-8821" required>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="form-item">
            <label>Quantity (Pcs)</label>
            <input type="number" id="mQty" placeholder="e.g. 240" required>
          </div>
          <div class="form-item">
            <label>Total Weight (Kg)</label>
            <input type="number" step="0.1" id="mWeight" placeholder="e.g. 2150" required>
          </div>
        </div>
        <div class="form-item">
          <label>Heat Code</label>
          <input type="text" id="mHeat" placeholder="e.g. HC-77">
        </div>
        <button type="submit" class="btn-submit">💾 Add to List</button>
      </form>
    </div>
  </div>

  <script>
    // Initial Trial Master Records
    let msMasterData = [
      { date: "2026-08-20", msNo: "MS-101", sqf: "SQF-1", part: "Input Shaft 16T", batch: "B-201", qty: 320, weightKg: 2240, heat: "HC-12", remarks: "Standard Cycle" },
      { date: "2026-08-20", msNo: "MS-102", sqf: "SQF-2", part: "Crown Wheel 41T", batch: "B-202", qty: 180, weightKg: 2160, heat: "HC-14", remarks: "Deep Case Depth" },
      { date: "2026-08-21", msNo: "MS-101", sqf: "SQF-3", part: "Input Shaft 16T", batch: "B-203", qty: 300, weightKg: 2100, heat: "HC-12", remarks: "Retempered" },
      { date: "2026-08-21", msNo: "MS-103", sqf: "SQF-4", part: "Bevel Gear 24T", batch: "B-204", qty: 450, weightKg: 2340, heat: "HC-18", remarks: "Standard Cycle" },
      { date: "2026-08-22", msNo: "MS-104", sqf: "SQF-1", part: "Diff Pinion", batch: "B-205", qty: 520, weightKg: 2080, heat: "HC-09", remarks: "Standard Cycle" },
      { date: "2026-08-22", msNo: "MS-102", sqf: "SQF-2", part: "Crown Wheel 41T", batch: "B-206", qty: 190, weightKg: 2280, heat: "HC-14", remarks: "Direct Quench" }
    ];

    function renderTable() {
      const q = document.getElementById('filterSearch').value.trim().toLowerCase();
      const sqfFilter = document.getElementById('filterSQF').value;
      const dateFilter = document.getElementById('filterDate').value;
      const tbody = document.getElementById('tableBody');

      let filtered = msMasterData.filter(item => {
        let matchQuery = item.msNo.toLowerCase().includes(q) || item.part.toLowerCase().includes(q) || item.batch.toLowerCase().includes(q);
        let matchSQF = (sqfFilter === 'ALL') || (item.sqf === sqfFilter);
        let matchDate = (!dateFilter) || (item.date === dateFilter);
        return matchQuery && matchSQF && matchDate;
      });

      // Sort MS Number wise, then Date descending
      filtered.sort((a, b) => a.msNo.localeCompare(b.msNo) || new Date(b.date) - new Date(a.date));

      let totalQty = 0;
      let totalKg = 0;
      let html = "";

      filtered.forEach(row => {
        let ton = (row.weightKg / 1000).toFixed(2);
        totalQty += Number(row.qty);
        totalKg += Number(row.weightKg);

        html += `
          <tr>
            <td>${row.date}</td>
            <td><span class="ms-tag">${row.msNo}</span></td>
            <td><span class="sqf-tag">${row.sqf}</span></td>
            <td style="font-weight:600; text-align:left; padding-left:14px;">${row.part}</td>
            <td>${row.batch}</td>
            <td style="color:#fde047; font-weight:700;">${row.qty.toLocaleString('en-IN')}</td>
            <td>${row.weightKg.toLocaleString('en-IN')}</td>
            <td style="color:#34d399; font-weight:700;">${ton}</td>
            <td>${row.heat || '-'}</td>
            <td style="font-size:11px; color:#94a3b8;">${row.remarks || '-'}</td>
          </tr>
        `;
      });

      if (!filtered.length) {
        html = `<tr><td colspan="10" style="padding: 24px; color: #94a3b8;">No matching MS Number records found.</td></tr>`;
      }

      tbody.innerHTML = html;

      // Update KPI
      document.getElementById('kpiLots').innerText = filtered.length;
      document.getElementById('kpiQty').innerText = `${totalQty.toLocaleString('en-IN')} Pcs`;
      document.getElementById('kpiTon').innerText = `${(totalKg / 1000).toFixed(2)} Ton`;
    }

    function resetFilters() {
      document.getElementById('filterSearch').value = '';
      document.getElementById('filterSQF').value = 'ALL';
      document.getElementById('filterDate').value = '';
      renderTable();
    }

    function openModal() {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('mDate').value = today;
      document.getElementById('entryModal').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('entryModal').style.display = 'none';
    }

    function saveEntry(e) {
      e.preventDefault();
      const newRec = {
        date: document.getElementById('mDate').value,
        msNo: document.getElementById('mMsNo').value.trim().toUpperCase(),
        sqf: document.getElementById('mSqf').value,
        part: document.getElementById('mPart').value.trim(),
        batch: document.getElementById('mBatch').value.trim(),
        qty: Number(document.getElementById('mQty').value),
        weightKg: Number(document.getElementById('mWeight').value),
        heat: document.getElementById('mHeat').value.trim(),
        remarks: "Manual Entry"
      };

      msMasterData.unshift(newRec);
      closeModal();
      renderTable();
      alert(`✅ Record added under ${newRec.msNo} successfully!`);
    }

    window.addEventListener('DOMContentLoaded', renderTable);
  </script>
</body>
</html>